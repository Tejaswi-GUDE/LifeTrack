{
  "name": "lifetrack-backend",
  "version": "1.0.0",
  "description": "LifeTrack (SIH) - Express API over the Mongoose data layer.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/devServer.js",
